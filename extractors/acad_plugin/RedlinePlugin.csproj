<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>RedlinePlugin</AssemblyName>
    <RootNamespace>Redline</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AcadDir Condition="'$(AcadDir)' == ''"></AcadDir>
    <AcadVersion Condition="'$(AcadVersion)' == ''">2027</AcadVersion>
    <OutputPath>bin\$(AcadVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <Target Name="NeedAcadDir" BeforeTargets="BeforeBuild;ResolveAssemblyReferences" Condition="'$(AcadDir)' == ''">
    <Error Text="AcadDir is empty. Pass the AutoCAD install folder, for example: -p:AcadDir=&quot;C:/Program Files/Autodesk/AutoCAD 2027&quot; -p:AcadVersion=2027" />
  </Target>

  <ItemGroup>
    <Reference Include="AcCoreMgd" Condition="'$(AcadDir)' != ''">
      <HintPath>$(AcadDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd" Condition="'$(AcadDir)' != ''">
      <HintPath>$(AcadDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <AssemblyMetadata Include="AcadVersion" Value="$(AcadVersion)" />
  </ItemGroup>
</Project>
